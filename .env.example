# ==============================================================================
# EduFlow — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================================

# ── Runtime Mode ───────────────────────────────────────────────────────────────
# 'development' uses SQLite + InMemory Channels + console email
# 'production'  requires PostgreSQL, Redis, and all security settings below
DJANGO_RUN_MODE=development

# ── Django Core ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_ADMIN_URL=django-admin/

# ── Database (required in production; optional in development) ─────────────────
DATABASE_URL=postgres://user:password@localhost:5432/eduflow

# ── Redis (required in production for Channels; optional in development) ───────
REDIS_URL=redis://localhost:6379/0

# ── Allowed Hosts (production only — comma-separated) ─────────────────────────
DJANGO_ALLOWED_HOSTS=yoursaas.com,www.yoursaas.com

# ── CSRF Trusted Origins (production — comma-separated full origins) ───────────
DJANGO_CSRF_TRUSTED_ORIGINS=https://yoursaas.com,https://www.yoursaas.com

# ── Email (production SMTP) ────────────────────────────────────────────────────
EMAIL_HOST=smtp.mailprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@yoursaas.com
EMAIL_HOST_PASSWORD=smtp-password-here
DEFAULT_FROM_EMAIL=EduFlow <noreply@yoursaas.com>

# ── Payments ───────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=ubjvdvdv

# ── AI / LLM (optional — for support assistant) ────────────────────────────────
AI_API_KEY=

# ── File Storage (optional S3-compatible object storage) ──────────────────────
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# ── Proxy (how many trusted reverse-proxy hops are in front of Django) ─────────
TRUSTED_PROXY_COUNT=1

# ── Development Flags ──────────────────────────────────────────────────────────
# Set to true to force in-memory Channels even when REDIS_URL is set (dev only)
USE_INMEMORY_CHANNELS=false
